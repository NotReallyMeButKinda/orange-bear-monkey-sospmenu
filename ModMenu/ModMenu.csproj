<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SocialSpaceModMenu</AssemblyName>
    <RootNamespace>SocialSpaceModMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- the game install; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\program files (x86)\steam\steamapps\common\Social Space</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MLDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.XRModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2CppNewtonsoft.Json.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <!-- the updater plugin is built first and embedded; the mod installs it into Plugins itself -->
  <ItemGroup>
    <ProjectReference Include="..\Updater\Updater.csproj" ReferenceOutputAssembly="false" Private="false" />
    <EmbeddedResource Include="..\Updater\bin\$(Configuration)\SocialSpaceModMenu.Updater.dll" LogicalName="SocialSpaceModMenu.Updater.dll" />
  </ItemGroup>

  <PropertyGroup>
    <!-- every Release build uploads the DLL to the GitHub release for its version -->
    <PublishRelease Condition="'$(PublishRelease)' == ''">true</PublishRelease>
  </PropertyGroup>

  <!-- a running game locks the old DLL; warn instead of failing so the release still goes out -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="PublishGitHubRelease" AfterTargets="CopyToMods"
          Condition="'$(Configuration)' == 'Release' And '$(PublishRelease)' == 'true'">
    <Exec ContinueOnError="WarnAndContinue"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\publish-release.ps1&quot; -DllPath &quot;$(TargetPath)&quot; -SourceFile &quot;$(MSBuildProjectDirectory)\ModMenu.cs&quot; -LicenseFile &quot;$(MSBuildProjectDirectory)\ThirdParty\GorillaLocomotion\LICENSE&quot; -ExtraFile &quot;$(MSBuildProjectDirectory)\..\Updater\bin\$(Configuration)\SocialSpaceModMenu.Updater.dll&quot;" />
  </Target>

</Project>
